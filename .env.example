# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# Login do painel (o navegador pede usuário e senha)
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-por-uma-senha-forte

# Fuso usado pelo servidor
TZ=America/Sao_Paulo

# Opcional: atraso máximo (minutos) pra ainda enviar uma mensagem que venceu com o servidor fora do ar
MAX_ATRASO_MIN=720
