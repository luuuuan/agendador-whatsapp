# Supabase: Project Settings -> Data API (URL) e API Keys (secret key, sb_secret_...)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_cole-aqui

# Recomendado: só cria conta quem souber este código (deixe vazio pra cadastro aberto)
CODIGO_CONVITE=troque-por-um-codigo

# Fuso usado pelo servidor
TZ=America/Sao_Paulo

# Opcional: atraso máximo (minutos) pra ainda enviar uma mensagem que venceu com o servidor fora do ar
MAX_ATRASO_MIN=720

# Opcional: segredo que assina o login. Se vazio, é derivado da chave do Supabase.
# SESSAO_SEGREDO=
